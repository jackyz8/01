PROJECT_MEM_MB=512
PROJECT_CPUS=1.0
PROJECT_PIDS=256
AUTO_RESTART_MAX=10
RESUME_ON_START=true

SESSION_COOKIE_SECURE=false
MONITOR_INTERVAL=5
PIP_TIMEOUT=900