SECRET_KEY=CHANGE_ME_RUN_secrets.token_hex
ENCRYPTION_KEY=
ADMIN_EMAIL=LOLGG@gmail.com
DATABASE_URL=sqlite:///instance/glory.db

SANDBOX_MODE=docker
DOCKER_IMAGE=python:3.11-slim
DOCKER_NETWORK=bridge
ALLOW_UNSANDBOXED_USERS=false

MAX_PROJECTS_PER_USER=5
